{
  "name": "@xappx/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:preview": "vite build --mode preview",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "dev:click-preview": "vite --config vite.click-preview.config.ts",
    "test:click-preview": "vitest run --config vitest.click-preview.config.ts",
    "test:e2e:click-preview": "playwright test --config playwright.click-preview.config.ts",
    "typecheck:click-preview": "tsc -p tsconfig.click-preview.json",
    "build:click-preview": "npm run typecheck:click-preview && vite build --config vite.click-preview.config.ts",
    "check:click-preview": "node tools/verify-click-preview.mjs dist-click-preview"
  },
  "dependencies": {
    "framer-motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "4.14.0",
    "jsdom": "25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "2.1.9"
  }
}
