{
  "$comment": "XAPPX design tokens, from the brand style guide. The platform's own surfaces (App Factory, Operations, Rewards Admin, marketing) use these. Client brand instances override theme values through their application record - these are the XAPPX defaults, not a global stylesheet.",
  "color": {
    "electric_cyan": {
      "value": "#00C2FF",
      "role": "Primary accent"
    },
    "mid_blue": {
      "value": "#0066FF",
      "role": "Core brand"
    },
    "deep_violet": {
      "value": "#7B5EFF",
      "role": "Secondary accent"
    },
    "deep_navy": {
      "value": "#080B12",
      "role": "Primary background"
    },
    "clean_white": {
      "value": "#FFFFFF",
      "role": "Primary text"
    },
    "cool_gray": {
      "value": "#8A9BB5",
      "role": "Secondary text"
    }
  },
  "gradient": {
    "primary": {
      "value": "linear-gradient(90deg, #00C2FF 0%, #0066FF 50%, #7B5EFF 100%)",
      "rule": "Always flows left to right, cyan to violet, mirroring the X bookends of the wordmark. Never reverse or rotate it."
    },
    "rule_divider": {
      "value": "linear-gradient(90deg, #00C2FF 0%, #7B5EFF 100%)"
    }
  },
  "typography": {
    "families": {
      "primary": "Inter",
      "alternate": "Space Grotesk"
    },
    "scale": {
      "display": {
        "size": "72px",
        "weight": 700
      },
      "heading": {
        "size": "48px",
        "weight": 600
      },
      "subheading": {
        "size": "32px",
        "weight": 500
      },
      "body": {
        "size": "16px",
        "weight": 400
      },
      "caption": {
        "size": "12px",
        "weight": 400
      }
    }
  },
  "logo": {
    "clearspace": "Equal to the height of the X letterform on all sides.",
    "min_width": {
      "large": "200px",
      "medium": "120px",
      "small": "80px"
    },
    "tagline_rule": "Tagline is omitted below 80px wide.",
    "backgrounds": [
      "dark (primary)",
      "light (primary)",
      "solid brand color (reversed)"
    ],
    "prohibited": "Low-contrast placements and any recoloring of the wordmark."
  }
}